{
  "rules": {
    ".read": false,
    ".write": false,

    "lobbies": {
      ".indexOn": ["meta/expiresAt"],

      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{6}$/)",
        ".write": "$code.matches(/^[A-Z0-9]{6}$/) && (!data.exists() || data.child('meta/expiresAt').val() > now || !newData.exists())",
        ".validate": "newData.hasChild('meta')",

        "meta": {
          ".validate": "newData.hasChildren(['code', 'host', 'createdAt', 'expiresAt'])",
          "code": { ".validate": "newData.isString() && newData.val() === $code" },
          "host": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'" },
          "gameId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "startedBy": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "startedAt": { ".validate": "newData.isNumber()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "expiresAt": { ".validate": "newData.isNumber() && newData.val() <= now + 43200000" },
          "film": {
            ".validate": "newData.hasChildren(['rolls', 'developAfterH'])",
            "rolls": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 40" },
            "developAfterH": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 48" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },

        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['id', 'name']) && newData.child('id').val() === $playerId",
            "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "drinkIcon": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "ready": { ".validate": "newData.isBoolean()" },
            "driver": { ".validate": "newData.isBoolean()" },
            "zone": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "shots": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
            "$other": { ".validate": false }
          }
        },

        "avatars": {
          "$playerId": {
            ".write": "!newData.exists()",
            ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 24000 && newData.parent().parent().child('players').child($playerId).exists()"
          }
        },

        "game": {
          ".validate": "newData.hasChildren(['id', 'startedAt', 'state'])",
          "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "startedAt": { ".validate": "newData.isNumber()" },
          "state": { ".validate": "newData.isString() && newData.val().length <= 200000" },
          "build": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "$other": { ".validate": false }
        },

        "inbox": {
          "$msgId": {
            ".validate": "newData.hasChildren(['by', 'at', 'action'])",
            "by": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "at": { ".validate": "newData.isNumber()" },
            "action": { ".validate": "newData.isString() && newData.val().length <= 4000" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}

### Spiele-Plugin-System (Detail)

Jedes Spiel ist ein eigenstaendiges Modul, das sich in eine zentrale Registry einhaengt:

```
src/
  games/
    registry.ts          # Zentrale Registry: Map<string, GameDefinition>
    types.ts             # Shared Interfaces
    truth-or-dare/
      index.ts           # Exportiert GameDefinition
      TruthOrDareGame.tsx # React-Komponente
      state.ts           # Spielspezifischer State/Reducer
      rules.ts           # Regeln & Karten-Decks
      config.ts          # Metadaten (Name, Min/Max Spieler, etc.)
    kings-cup/
      index.ts
      KingsCupGame.tsx
      state.ts
      rules.ts
      config.ts
    busfahrer/
      ...
```

**Zentrales Interface:**

```typescript
// types.ts -- Spiel-Plugin-Interface
interface GameDefinition {
  id: string;                        // Eindeutige ID (z.B. "truth-or-dare")
  name: string;                      // Anzeigename
  description: string;               // Kurzbeschreibung
  minPlayers: number;
  maxPlayers: number;
  estimatedDuration: string;         // z.B. "15-30 Min"
  alcoholRequired: boolean;          // Kann auch ohne Alkohol gespielt werden?
  component: React.LazyComponent;    // Lazy-loaded React-Komponente
  createInitialState: (players: Player[]) => GameState;
  reducer: (state: GameState, action: GameAction) => GameState;
}

// types.ts -- Getraenke & Schluck-Berechnung
interface DrinkDefinition {
  id: string;                        // z.B. "beer-pils"
  name: string;                      // z.B. "Bier (Pils)"
  category: "beer" | "wine" | "cocktail" | "spirit" | "other";
  defaultVolumeMl: number;           // z.B. 330
  abvPercent: number;                // z.B. 5.0
  sipSizeMl: number;                 // z.B. 40
  alcoholPerSipGrams: number;        // berechnet: sipSize * abv/100 * 0.789
  icon: string;                      // Emoji oder Icon-Key
}

interface PlayerDrinkState {
  playerId: string;
  selectedDrink: DrinkDefinition;
  drinkLog: DrinkLogEntry[];         // Zeitstempel + Menge jedes Schlucks
  currentBac: number;                // Laufend berechnet
  targetBac: number;                 // Default 0.4, anpassbar
  phase: "reaching" | "maintaining"; // Pegel aufbauen vs. halten
}

// Zentrale Funktion, die von allen Spielen aufgerufen wird:
function calculateSipsForPlayer(player: PlayerDrinkState): number;
```

**Neues Spiel hinzufuegen = 1 Ordner + 1 Zeile in der Registry.** Kein Refactoring am bestehenden UI oder Routing noetig.


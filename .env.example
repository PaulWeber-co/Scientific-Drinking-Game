# Vorlage für .env.local – NUR Platzhalter, keine echten Werte einchecken.
# Alles mit VITE_ landet im Client-Bundle und ist damit öffentlich.

# Öffentlicher Firebase-Web-API-Key (kein Geheimnis, aber in der Google Cloud
# Console auf Domain + Identity Toolkit API beschränken). Nötig für die
# anonyme Anmeldung der Online-Lobby.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key

# Optional: eigene Firebase-Instanz statt der fest hinterlegten.
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_DB_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
